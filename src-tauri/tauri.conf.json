{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoftwareFactory",
  "version": "0.1.0",
  "identifier": "dev.plonter.softwarefactory",
  "build": {
    "beforeDevCommand": "npm run dev -w @sf/bridge",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/bridge/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoftwareFactory \u00b7 Bridge",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../packages/core/dist/": "core/",
      "../packages/core/package.json": "core/package.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NjA4RUQ2OTBDMTcyRTEKUldUaGNzR1ExbzVncDVGUDVhNFdXQ3NWV2RLOVMwWEdqKzZTRXZXYnJkeEMwYTBhaWQ2b0RjSlIK",
      "endpoints": [
        "https://api.github.com/repos/PlonterAsi/SoftwareFactory/contents/latest.json?ref=updates"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
