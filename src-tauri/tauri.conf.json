{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoftwareFactory",
  "version": "0.1.0",
  "identifier": "dev.plonter.softwarefactory",
  "build": {
    "beforeDevCommand": "npm run dev -w @sf/bridge",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/bridge/dist"
  },
  "app": {
    "windows": [{ "title": "SoftwareFactory · Bridge", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
